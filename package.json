{
  "name": "vrc-event-creator",
  "version": "1.2.0",
  "main": "electron/main.js",
  "scripts": {
    "start:gui": "electron .",
    "dist:gui": "electron-builder --win",
    "dist:gui:all": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "Cynacedia",
  "license": "MIT",
  "description": "VRChat Event Creator",
  "overrides": {
    "lodash": "^4.17.23"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "keyv-file": "^5.3.3",
    "luxon": "^3.7.2",
    "vrchat": "^2.21.7"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.9.0",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.vrceventmaker.app",
    "productName": "VRChat Event Creator",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Cynacedia",
      "repo": "VRC-Event-Creator"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/app.ico",
      "artifactName": "VRChat-Event-Creator-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "en_US",
        "de_DE",
        "fr_FR",
        "es_ES",
        "ja_JP",
        "ko_KR",
        "pt_BR",
        "ru_RU",
        "zh_CN",
        "nl_NL"
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/app.ico"
    }
  }
}
